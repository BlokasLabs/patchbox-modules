[Unit]
Description=Pimidipy Script Runner
After=sound.target
Wants=sound.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=-/etc/pimidipy.conf
EnvironmentFile=-/etc/environment
EnvironmentFile=/run/pimidipy.active
Environment=PYTHONPATH=/var/pimidipy-scripts
WorkingDirectory=/var/pimidipy-scripts
ExecStartPre=/usr/bin/python3 -c "print(\"Starting ${PIMIDIPY_SCRIPT}\")"
ExecStart=/usr/bin/python3 -u $PIMIDIPY_SCRIPT
KillSignal=SIGINT
User=pimidipy
Group=pimidipy
Restart=always
RestartSec=2
